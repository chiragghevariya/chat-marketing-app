APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite (zero-config, great for getting started quickly).
# IMPORTANT: the location/radius search needs SQL math functions that SQLite
# does NOT provide. Use MySQL or PostgreSQL (below) if you need that feature.
# Production uses PostgreSQL on AWS RDS.
DB_CONNECTION=sqlite

# --- PostgreSQL (production / AWS RDS) ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=chat_marketplace
# DB_USERNAME=postgres
# DB_PASSWORD=

# --- MySQL (alternative for local dev) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=chat_marketplace
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time broadcasting. (Laravel 11 uses BROADCAST_CONNECTION, not the older
# BROADCAST_DRIVER.) Use "pusher" for chat; "log" locally if you have no keys yet.
BROADCAST_CONNECTION=pusher

# Pusher Channels — get these from https://dashboard.pusher.com (Phase 2: chat).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Optional: self-hosted / Pusher-compatible server (e.g. soketi). Leave blank for hosted Pusher.
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
FILESYSTEM_DISK=local

# Real-time chat (MessageSent implements ShouldBroadcast) is dispatched via the
# QUEUE. With "database" you MUST run `php artisan queue:work` or broadcasts never
# reach Pusher. For local dev you can use QUEUE_CONNECTION=sync to fire inline.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Authentication (JWT) — tymon/jwt-auth
# ----------------------------------------------------------------------------
# API-only backend: the default guard is the JWT "api" guard.
AUTH_GUARD=api
# Generate this value with:  php artisan jwt:secret
JWT_SECRET=

# ----------------------------------------------------------------------------
# AWS S3 — used by ImageUploadService for listing/avatar uploads
# (config/filesystems.php reads these values for the "s3" disk)
# ----------------------------------------------------------------------------
# ImageUploadService ALWAYS uploads to the dedicated "s3" disk (configured by the
# AWS_* vars below) regardless of FILESYSTEM_DISK. FILESYSTEM_DISK only sets
# Laravel's *default* disk for other Storage::* calls. So just fill in the AWS_*
# vars — you do not need to change FILESYSTEM_DISK for image uploads to work.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Optional: a CloudFront (CDN) domain that fronts the bucket. When set, uploaded
# files are returned as https://<this-domain>/<path> instead of the raw S3 URL.
AWS_URL=
# Optional: custom S3-compatible endpoint, e.g. MinIO -> http://127.0.0.1:9000
# Leave blank for real AWS S3.
AWS_ENDPOINT=
# Leave false for real AWS S3. Set true only for S3-compatible services (MinIO).
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------------
# Stripe Connect — marketplace payments (Phase 3)
# Get keys from https://dashboard.stripe.com/apikeys (use TEST keys in dev).
# ----------------------------------------------------------------------------
STRIPE_KEY=                       # publishable key (pk_test_...) — used by the frontend
STRIPE_SECRET=                    # secret key (sk_test_...) — used by the backend
# Signing secret for POST /api/stripe/webhook. From `stripe listen` or the
# dashboard webhook settings: whsec_...
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_PLATFORM_FEE_PERCENT=10    # platform commission taken from each sale (%)

VITE_APP_NAME="${APP_NAME}"

# Frontend env for Laravel Echo + pusher-js (read by Vite at build time).
# In JS:  import Echo from 'laravel-echo'; import Pusher from 'pusher-js';
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
